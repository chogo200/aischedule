// Use DBML to define your database structure
// Docs: https://dbml.dbdocs.io/docs

enum user_role {
  admin
  permis1
  permis2
}

Table users {
  id int [pk, increment]
  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null]
  name_th varchar(255) [not null]
  role user_role [not null]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table teacher {
  id int [pk, increment]
  user_id int [not null]
  portfolio text
}

Table subject {
  id int [pk, increment]
  name varchar(255) [not null, unique]
  level varchar(255)
}

Table teacher_expert {
  id int [pk, increment]
  teacher_id int [not null]
  subject_id int [not null]
  score int [not null]
}

Table room_expert {
  id int [pk, increment]
  room_id int [not null]
  subject_id int [not null]
  expert int [not null]
}

Table project {
  id int [pk]
  name varchar(255) [not null, unique]
}

Table class {
  id int [pk, increment]
  name varchar(255) [not null, unique]
}

Table room {
  id int [pk, increment]
  name varchar(255) [not null, unique]
  feature text
}

Table class_in_project {
  id int [pk, increment]
  project_id int [not null]
  class_id int [not null]
  name varchar(255)
}

Table lesson_plan {
  id int [pk, increment]
  project_id int [not null]
  name varchar(255) [not null]
  subjects json [not null]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table room_in_project {
  id int [pk, increment]
  project_id int [not null]
  room_id int [not null]
}

Table teacher_in_project {
  id int [pk, increment]
  project_id int [not null]
  teacher_id int [not null]
}

Table schedule {
  id int [pk, increment]
  period int [not null]
  class_id int
  teacher_id int
  subject_id int
  project_id int [not null]
  room_id int [not null]
}

// Foreign Key Relationships

Ref: teacher.user_id > users.id [delete: cascade]

Ref: teacher_expert.teacher_id > teacher.id [delete: cascade]
Ref: teacher_expert.subject_id > subject.id [delete: cascade]

Ref: room_expert.room_id > room.id [delete: cascade]
Ref: room_expert.subject_id > subject.id [delete: cascade]

Ref: class_in_project.class_id > class.id [delete: cascade]
Ref: class_in_project.project_id > project.id [delete: cascade]

Ref: lesson_plan.project_id > project.id [delete: cascade]

Ref: room_in_project.room_id > room.id [delete: cascade]
Ref: room_in_project.project_id > project.id [delete: cascade]

Ref: teacher_in_project.teacher_id > teacher.id [delete: cascade]
Ref: teacher_in_project.project_id > project.id [delete: cascade]

Ref: schedule.class_id > class.id [delete: cascade]
Ref: schedule.teacher_id > teacher.id [delete: cascade]
Ref: schedule.subject_id > subject.id [delete: cascade]
Ref: schedule.project_id > project.id [delete: cascade]
Ref: schedule.room_id > room.id [delete: cascade]
